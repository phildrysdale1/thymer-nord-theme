/*
* Nord Theme for Thymer
* Official dark/light color scheme by Nord Theme
* Variants: Nord Classic (Dark) and Nord Classic (Light)
*
* Color Usage Based on Official Nord Spec:
* - Frost (#8FBCBB, #88C0D0, #81A1C1, #5E81AC): Primary UI components, highlights
* - Aurora (#BF616A, #D08770, #EBCB8B, #A3BE8C, #B48EAD): Errors, warnings, success, numbers
* - Polar Night (#2E3440, #3B4252, #434C5E, #4C566A): Dark ambiance backgrounds / bright ambiance text
* - Snow Storm (#D8DEE9, #E5E9F0, #ECEFF4): Dark ambiance text / bright ambiance backgrounds
*/

/* ------------------------------------------- */
/* Nord Classic - Arctic Dark                  */
/* ------------------------------------------- */
html[data-theme="basic-dark-nord"] {
    color-scheme: dark;

    /* ------------------------------------------- */
    /* 1. Headings - Frost Teal                   */
    /* ------------------------------------------- */
    .heading-h1,
    .heading-h2,
    .heading-h3,
    .heading-h4,
    .heading-h5,
    .heading-h6 {
        color: #8FBCBB;
    }

    --text-base-size: 16px;
  
    /* ------------------------------------------- */
    /* 2. Background Colors - Polar Night         */
    /* ------------------------------------------- */
    --color-bg-50: #4C566A;
    --color-bg-100: #434C5E;
    --color-bg-150: #3B4252;
    --color-bg-200: #2E3440;
    --color-bg-300: #2E3440;
    --color-bg-400: #2E3440;
    --color-bg-500: #2E3440;
    --color-bg-600: #2E3440;
    --color-bg-700: #3B4252;
    --color-bg-800: #3B4252; /* Sidebar - background light */
    --color-bg-900: #2E3440;  /* Main window - main background */
    --color-bg-950: #2E3440;
    --color-bg-500-50: rgba(46, 52, 64, 0.5);
    --color-bg-950-50: rgba(46, 52, 64, 0.65);

    /* ------------------------------------------- */
    /* 3. Primary Colors - Nord Frost Accent      */
    /* ------------------------------------------- */
    --color-primary-50: #ECEFF4;
    --color-primary-100: #E5E9F0;
    --color-primary-200: #D8DEE9;
    --color-primary-300: #8FBCBB;
    --color-primary-400: #88C0D0; /* Frost Accent */
    --color-primary-500: #81A1C1;
    --color-primary-600: #5E81AC;
    --color-primary-700: #4C566A;
    --color-primary-800: #434C5E;
    --color-primary-900: #3B4252;
    --color-primary-950: #2E3440;
    --color-primary-400-70: rgba(136, 192, 208, 0.7);
    --color-primary-950-20: rgba(46, 52, 64, 0.2);
    --color-primary-text-100: #2E3440;

    /* ------------------------------------------- */
    /* 4. Text & Icons - Snow Storm Foreground    */
    /* ------------------------------------------- */
    --color-text-50: #ECEFF4;
    --color-text-100: #ECEFF4;
    --color-text-200: #E5E9F0;
    --color-text-300: #D8DEE9;
    --color-text-400: #D8DEE9;
    --color-text-500: #D8DEE9;
    --color-text-600: #4C566A;
    --color-text-700: #88C0D0;
    --color-text-800: #D8DEE9;
    --color-text-900: #3B4252;
    --color-text-950: #4C566A;

    /* ------------------------------------------- */
    /* 5. Semantic Colors - Nord Aurora           */
    /* ------------------------------------------- */
    --text-ok: #A3BE8C;
    --text-status-online: #A3BE8C;
    --text-warning: #EBCB8B;
    --text-error: #BF616A;
    --bg-alert: #BF616A;
    --fg-alert: #ECEFF4;

    /* ------------------------------------------- */
    /* 6. Links, Tags & Mentions - Themed         */
    /* ------------------------------------------- */
    --link-color: #81A1C1;
    --link-hover-color: #88C0D0;
    --ed-link-color: #81A1C1;
    --ed-link-hover-color: #88C0D0;

    --ed-hashtag-color: #B48EAD;
    --ed-hashtag-bg: rgba(180, 142, 173, 0.15);

    --ed-mention-color: #88C0D0;
    --ed-mention-bg: rgba(136, 192, 208, 0.15);
    --ed-mention-hover-bg: rgba(136, 192, 208, 0.25);
    --ed-mention-hover-color: #8FBCBB;

    --ed-datetime-color: #D08770;
    --ed-datetime-bg: rgba(208, 135, 112, 0.15);

    /* ------------------------------------------- */
    /* 7. Tasks & Checkboxes - Frost              */
    /* ------------------------------------------- */
    --ed-check-div-border: #88C0D0;
    --ed-check-div-hover-border: #8FBCBB;
    --ed-check-done-bg: #88C0D0;
    --ed-check-done-fg: #2E3440;

    /* Done task styling */
    .listitem.listitem-task.state-done .lineitem-text {
        color: #4C566A !important;
        text-decoration-color: #4C566A !important;
        opacity: 1 !important;
    }

    /* ------------------------------------------- */
    /* 8. Selection & Caret                       */
    /* ------------------------------------------- */
    --selection-bg: rgba(67, 76, 94, 0.8);
    --selection-fg: #ECEFF4;
    --ed-selection-self-bg: rgba(67, 76, 94, 0.8);
    --ed-selection-blurred-bg: rgba(67, 76, 94, 0.5);

    --ed-caret-self-radius: 2px;
    --ed-caret-self-border-width: 0px;
    --ed-caret-self-background: color-mix(in srgb, #88C0D0 70%, transparent);
    --ed-caret-self-box-shadow: 0 0 2px #88C0D0;

    /* ------------------------------------------- */
    /* 9. Quotes & Code - Dark Containers         */
    /* ------------------------------------------- */
    --ed-quote-border-color: #8FBCBB;
    
    --ed-container-border-color: rgba(76, 86, 106, 0.25);  /* #4C566A */
    --ed-container-bg-color:     rgba(216, 222, 233, 0.08); /* #D8DEE9 */
    
    --ed-code-bg:                rgba(76, 86, 106, 0.25);  /* #4C566A */
    --ed-code-border:            rgba(216, 222, 233, 0.08); /* #D8DEE9 */

    /* Inline code */
    .lineitem-code {
        background-color: var(--color-bg-200) !important;
        color: #D08770 !important;
        border-radius: 4px;
        padding: 2px 5px;
        font-family: var(--font-monospace);
    }

    /* Note blocks */
    --ed-block-note-bg: rgba(143, 188, 187, 0.1);
    --ed-block-note-border: #8FBCBB;

    /* ------------------------------------------- */
    /* 10. UI Components - Dark Interface         */
    /* ------------------------------------------- */
    --cards-bg: #2E3440;
    --cards-hover-bg: #3B4252;
    --cards-border-color: transparent;
    --cards-border-color-focused: transparent;

    --side-bg-active-focus: #88C0D0;
    --side-fg-active-focus: #2E3440;
    --sidebar-bg-hover: #3B4252;
    --sidebar-border-color: transparent;

    --cmdpal-bg-color: #2E3440;
    --cmdpal-selected-bg-color: #88C0D0;
    --cmdpal-selected-fg-color: #2E3440;
    --cmdpal-hover-bg-color: #3B4252;
    --cmdpal-border-color: transparent;

    --input-bg-color: #2E3440;
    --input-border-color: transparent;
    --input-border-focus: 1px solid #88C0D0;
    --input-border-shadow: 0 0 8px rgba(136, 192, 208, 0.4);

    --button-primary-bg-color: #88C0D0;
    --button-primary-fg-color: #2E3440;
    --button-primary-bg-hover-color: #8FBCBB;
    --button-bg-color: #3B4252;
    --button-border-color: transparent;
    --button-bg-hover-color: #434C5E;

    --color-shadow: rgba(46, 52, 64, 0.5);
    --color-shadow-cards: 0 4px 6px rgba(46, 52, 64, 0.4);
    --color-shadow-hover: 0 6px 12px rgba(46, 52, 64, 0.5);

    --logo-color: #88C0D0;
    --logo-glow-shadow:
        0 0 15px rgba(136, 192, 208, 0.4),
        0 0 30px rgba(136, 192, 208, 0.2);

    /* Enums - Nord Palette */
    --enum-red-bg: rgba(191, 97, 106, 0.25);
    --enum-red-fg: #BF616A;
    --enum-orange-bg: rgba(208, 135, 112, 0.25);
    --enum-orange-fg: #D08770;
    --enum-yellow-bg: rgba(235, 203, 139, 0.25);
    --enum-yellow-fg: #EBCB8B;
    --enum-green-bg: rgba(163, 190, 140, 0.25);
    --enum-green-fg: #A3BE8C;
    --enum-cyan-bg: rgba(143, 188, 187, 0.25);
    --enum-cyan-fg: #8FBCBB;
    --enum-blue-bg: rgba(129, 161, 193, 0.25);
    --enum-blue-fg: #81A1C1;
    --enum-purple-bg: rgba(180, 142, 173, 0.25);
    --enum-purple-fg: #B48EAD;
    --enum-pink-bg: rgba(180, 142, 173, 0.25);
    --enum-pink-fg: #B48EAD;

    --prop-border-focused: #2E3440;
    --prop-bg-focused: rgba(136, 192, 208, 0.3);
    --shadow-sticky-row: 0 6px 12px rgba(0, 0, 0, 0);
    --ed-drag-handle-color: #88C0D0;
    --ed-drag-handle-hover-border: #8FBCBB;

    --gradient-scrim: none;
}

/* ------------------------------------------- */
/* Nord Classic - Arctic Light                 */
/* ------------------------------------------- */
html[data-theme="basic-light-nord"] {
    color-scheme: light;

    /* ------------------------------------------- */
    /* 1. Headings - Deep Frost Blue              */
    /* ------------------------------------------- */
    .heading-h1,
    .heading-h2,
    .heading-h3,
    .heading-h4,
    .heading-h5,
    .heading-h6 {
        color: #5E81AC;
    }

    /* ------------------------------------------- */
    /* 2. Background Colors - Snow Storm          */
    /* ------------------------------------------- */
    --color-bg-50: #4C566A;
    --color-bg-100: #D8DEE9;
    --color-bg-150: #E5E9F0;
    --color-bg-200: #ECEFF4;
    --color-bg-300: #ECEFF4;
    --color-bg-400: #ECEFF4;
    --color-bg-500: #ECEFF4;
    --color-bg-600: #ECEFF4;
    --color-bg-700: #FFFFFF;
    --color-bg-800: #E5E9F0; /* Sidebar - light */
    --color-bg-900: #ECEFF4; /* Main window - light */
    --color-bg-950: #FFFFFF;
    --color-bg-500-50: rgba(236, 239, 244, 0.5);
    --color-bg-950-50: rgba(255, 255, 255, 0.65);

    /* ------------------------------------------- */
    /* 3. Primary Colors - Deep Frost Accent      */
    /* ------------------------------------------- */
    --color-primary-50: #2E3440;
    --color-primary-100: #3B4252;
    --color-primary-200: #434C5E;
    --color-primary-300: #4C566A;
    --color-primary-400: #5E81AC; /* Frost Accent */
    --color-primary-500: #81A1C1;
    --color-primary-600: #88C0D0;
    --color-primary-700: #8FBCBB;
    --color-primary-800: #D8DEE9;
    --color-primary-900: #E5E9F0;
    --color-primary-950: #ECEFF4;
    --color-primary-400-70: rgba(94, 129, 172, 0.7);
    --color-primary-950-20: rgba(236, 239, 244, 0.2);
    --color-primary-text-100: #ECEFF4;

    /* ------------------------------------------- */
    /* 4. Text & Icons - Polar Night              */
    /* ------------------------------------------- */
    --color-text-50: #2E3440;
    --color-text-100: #2E3440;
    --color-text-200: #3B4252;
    --color-text-300: #434C5E;
    --color-text-400: #4C566A;
    --color-text-500: #4C566A;
    --color-text-600: #4C566A;
    --color-text-700: #5E81AC;
    --color-text-800: #2E3440;
    --color-text-900: #ECEFF4;
    --color-text-950: #4C566A;

    /* ------------------------------------------- */
    /* 5. Semantic Colors - Nord Aurora           */
    /* ------------------------------------------- */
    --text-ok: #A3BE8C;
    --text-status-online: #A3BE8C;
    --text-warning: #EBCB8B;
    --text-error: #BF616A;
    --bg-alert: #BF616A;
    --fg-alert: #ECEFF4;

    /* ------------------------------------------- */
    /* 6. Links, Tags & Mentions - Themed         */
    /* ------------------------------------------- */
    --link-color: #5E81AC;
    --link-hover-color: #81A1C1;
    --ed-link-color: #5E81AC;
    --ed-link-hover-color: #81A1C1;

    --ed-hashtag-color: #B48EAD;
    --ed-hashtag-bg: rgba(180, 142, 173, 0.1);

    --ed-mention-color: #88C0D0;
    --ed-mention-bg: rgba(136, 192, 208, 0.1);
    --ed-mention-hover-bg: rgba(136, 192, 208, 0.2);
    --ed-mention-hover-color: #81A1C1;

    --ed-datetime-color: #D08770;
    --ed-datetime-bg: rgba(208, 135, 112, 0.1);

    /* ------------------------------------------- */
    /* 7. Tasks & Checkboxes - Deep Frost         */
    /* ------------------------------------------- */
    --ed-check-div-border: #5E81AC;
    --ed-check-div-hover-border: #81A1C1;
    --ed-check-done-bg: #5E81AC;
    --ed-check-done-fg: #ECEFF4;

    /* Done task styling */
    .listitem.listitem-task.state-done .lineitem-text {
        color: #4C566A !important;
        text-decoration-color: #4C566A !important;
        opacity: 1 !important;
    }

    /* ------------------------------------------- */
    /* 8. Selection & Caret                       */
    /* ------------------------------------------- */
    --selection-bg: rgba(216, 222, 233, 0.6);
    --selection-fg: #2E3440;
    --ed-selection-self-bg: rgba(216, 222, 233, 0.6);
    --ed-selection-blurred-bg: rgba(216, 222, 233, 0.3);

    --ed-caret-self-radius: 2px;
    --ed-caret-self-border-width: 0px;
    --ed-caret-self-background: color-mix(in srgb, #5E81AC 70%, transparent);
    --ed-caret-self-box-shadow: 0 0 2px #5E81AC;

    /* ------------------------------------------- */
    /* 9. Quotes & Code - Light Containers        */
    /* ------------------------------------------- */
    --ed-quote-border-color: #81A1C1;

    --ed-container-border-color: rgba(216, 222, 233, 0.25); /* #D8DEE9 */
    --ed-container-bg-color:     rgba(76, 86, 106, 0.08);   /* #4C566A */
    
    --ed-code-bg:                rgba(216, 222, 233, 0.25); /* #D8DEE9 */
    --ed-code-border:            rgba(76, 86, 106, 0.08);   /* #4C566A */

    /* Inline code */
    .lineitem-code {
        background-color: var(--color-bg-200) !important;
        color: #D08770 !important;
        border-radius: 4px;
        padding: 2px 5px;
        font-family: var(--font-monospace);
    }

    /* Note blocks */
    --ed-block-note-bg: rgba(136, 192, 208, 0.08);
    --ed-block-note-border: #88C0D0;

    /* ------------------------------------------- */
    /* 10. UI Components - Light Interface        */
    /* ------------------------------------------- */
    --cards-bg: #ECEFF4;
    --cards-hover-bg: #E5E9F0;
    --cards-border-color: transparent;
    --cards-border-color-focused: transparent;

    --side-bg-active-focus: #5E81AC;
    --side-fg-active-focus: #ECEFF4;
    --sidebar-bg-hover: #E5E9F0;
    --sidebar-border-color: transparent;

    --cmdpal-bg-color: #ECEFF4;
    --cmdpal-selected-bg-color: #5E81AC;
    --cmdpal-selected-fg-color: #ECEFF4;
    --cmdpal-hover-bg-color: #E5E9F0;
    --cmdpal-border-color: transparent;

    --input-bg-color: #ECEFF4;
    --input-border-color: transparent;
    --input-border-focus: 1px solid #5E81AC;
    --input-border-shadow: 0 0 8px rgba(94, 129, 172, 0.3);

    --button-primary-bg-color: #5E81AC;
    --button-primary-fg-color: #ECEFF4;
    --button-primary-bg-hover-color: #81A1C1;
    --button-bg-color: #E5E9F0;
    --button-border-color: transparent;
    --button-bg-hover-color: #D8DEE9;

    --color-shadow: rgba(46, 52, 64, 0.12);
    --color-shadow-cards: 0 4px 6px rgba(46, 52, 64, 0.08);
    --color-shadow-hover: 0 6px 12px rgba(46, 52, 64, 0.15);

    --logo-color: #5E81AC;
    --logo-glow-shadow:
        0 0 15px rgba(94, 129, 172, 0.3),
        0 0 30px rgba(94, 129, 172, 0.2);

    /* Enums - Nord Palette */
    --enum-red-bg: rgba(191, 97, 106, 0.15);
    --enum-red-fg: #BF616A;
    --enum-orange-bg: rgba(208, 135, 112, 0.15);
    --enum-orange-fg: #D08770;
    --enum-yellow-bg: rgba(235, 203, 139, 0.15);
    --enum-yellow-fg: #EBCB8B;
    --enum-green-bg: rgba(163, 190, 140, 0.15);
    --enum-green-fg: #A3BE8C;
    --enum-cyan-bg: rgba(143, 188, 187, 0.15);
    --enum-cyan-fg: #8FBCBB;
    --enum-blue-bg: rgba(129, 161, 193, 0.15);
    --enum-blue-fg: #81A1C1;
    --enum-purple-bg: rgba(180, 142, 173, 0.15);
    --enum-purple-fg: #B48EAD;
    --enum-pink-bg: rgba(180, 142, 173, 0.15);
    --enum-pink-fg: #B48EAD;

    --prop-border-focused: #ECEFF4;
    --prop-bg-focused: rgba(94, 129, 172, 0.15);
    --shadow-sticky-row: 0 6px 12px rgba(0, 0, 0, 0);
    --ed-drag-handle-color: #5E81AC;
    --ed-drag-handle-hover-border: #81A1C1;

    --gradient-scrim: none;
}
